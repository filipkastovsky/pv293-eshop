                      "../**/inventory/**",
                      "../**/fulfilment",
                      "../**/fulfilment/**",
                      "../**/payment",
                      "../**/payment/**",
                      "../**/notifications",
                      "../**/notifications/**",
                      "@/**",
                      "~/**",
                      "src/**"
                    ],
                    "message": "src/platform/** may import only src/contracts/**."
                  }
                ]
              }
            }
          }
        }
      },
      "includes": ["src/platform/**"]
    }
  ],
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
