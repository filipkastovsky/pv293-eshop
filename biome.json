{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!.superpowers",
      "!test/lint/fixtures",
      "!**/meta/_journal.json",
      "!**/meta/*_snapshot.json",
      "!**/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**/checkout",
                      "../**/checkout/**",
                      "../**/inventory",
                      "../**/inventory/**",
                      "../**/fulfilment",
                      "../**/fulfilment/**",
                      "../**/payment",
                      "../**/payment/**",
                      "../**/notifications",
                      "../**/notifications/**",
                      "../**/platform/**",
                      "@/**",
                      "~/**",
                      "src/**"
                    ],
                    "message": "Module 'catalog' may import only its own files, src/contracts/**, the platform index (src/platform) and libraries."
                  }
                ]
              }
            }
          }
        }
      },
      "includes": ["src/catalog/**"]
    },
    {
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**/catalog",
                      "../**/catalog/**",
                      "../**/inventory",
                      "../**/inventory/**",
                      "../**/fulfilment",
                      "../**/fulfilment/**",
                      "../**/payment",
                      "../**/payment/**",
                      "../**/notifications",
                      "../**/notifications/**",
                      "../**/platform/**",
                      "@/**",
                      "~/**",
                      "src/**"
                    ],
                    "message": "Module 'checkout' may import only its own files, src/contracts/**, the platform index (src/platform) and libraries."
                  }
                ]
              }
            }
          }
        }
      },
      "includes": ["src/checkout/**"]
    },
    {
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**/catalog",
                      "../**/catalog/**",
                      "../**/checkout",
                      "../**/checkout/**",
                      "../**/fulfilment",
                      "../**/fulfilment/**",
                      "../**/payment",
                      "../**/payment/**",
                      "../**/notifications",
